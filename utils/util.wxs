// utils/util.wxs - 可在WXML中调用的工具函数

var pad = function(n) {
  return n < 10 ? '0' + n : '' + n
}

var formatDate = function(dateStr) {
  return dateStr
}

var calcParDiff = function(total, par) {
  var diff = total - par
  if (diff === 0) return 'E'
  return diff > 0 ? '+' + diff : '' + diff
}

module.exports = {
  formatDate: formatDate,
  calcParDiff: calcParDiff
}
