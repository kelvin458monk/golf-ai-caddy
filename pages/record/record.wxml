<!-- pages/record/record.wxml -->
<wxs src="../../utils/util.wxs" module="u" />
<view class="container">

  <!-- 步骤1：选择球场 -->
  <view wx:if="{{step === 'select_course'}}" class="step-panel">
    <view class="step-header">
      <text class="step-title">选择球场</text>
      <text class="step-desc">选择您今天下场的球场</text>
    </view>
    <view class="course-list">
      <view 
        wx:for="{{courses}}" 
        wx:key="id" 
        class="course-card card"
        bindtap="selectCourse"
        data-id="{{item.id}}"
      >
        <text class="course-name">{{item.name}}</text>
        <text class="course-info">{{item.holes}}洞 · 标准杆{{item.par}}</text>
      </view>
    </view>
  </view>

  <!-- 步骤2：输入杆数 -->
  <view wx:elif="{{step === 'input_score'}}" class="step-panel">
    <view class="score-header">
      <text class="hole-progress">第 {{currentHoleIndex + 1}} / 18 洞</text>
      <text class="course-name-small">{{selectedCourse.name}}</text>
    </view>

    <!-- 进度条 -->
    <view class="progress-bar">
      <view 
        wx:for="{{holes}}" 
        wx:key="hole" 
        class="progress-dot {{item.inputted ? 'done' : ''}} {{currentHoleIndex === index ? 'active' : ''}}"
        bindtap="jumpToHole"
        data-index="{{index}}"
      >
      </view>
    </view>

    <!-- 标准杆选择 -->
    <view class="par-select">
      <text class="section-label">标准杆</text>
      <view class="par-options">
        <view 
          wx:for="{{[3,4,5]}}" 
          wx:key="*this"
          class="par-btn {{parForCurrentHole === item ? 'selected' : ''}}"
          bindtap="setPar"
          data-val="{{item}}"
        >
          Par {{item}}
        </view>
      </view>
    </view>

    <!-- 杆数输入（大号数字选择器） -->
    <view class="stroke-input-area">
      <text class="section-label">杆数</text>
      <view class="stroke-display">
        <view class="stroke-adjust" bindtap="adjustStroke" data-delta="-1">−</view>
        <view class="stroke-value">{{strokeInput}}</view>
        <view class="stroke-adjust" bindtap="adjustStroke" data-delta="1">+</view>
      </view>
      <!-- 快捷选择 -->
      <view class="quick-strokes">
        <view 
          wx:for="{{[1,2,3,4,5,6,7,8,9]}}" 
          wx:key="*this"
          class="quick-btn {{strokeInput === item ? 'selected' : ''}}"
          bindtap="setStroke"
          data-val="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <!-- 确认按钮 -->
    <button class="btn-primary confirm-btn" bindtap="confirmHole">
      {{currentHoleIndex >= 17 ? '查看成绩' : '确认，下一洞'}}
    </button>
  </view>

  <!-- 步骤3：预览 -->
  <view wx:elif="{{step === 'preview'}}" class="step-panel">
    <view class="preview-header">
      <text class="preview-title">{{selectedCourse.name}}</text>
      <text class="preview-date">{{item.date}}</text>
    </view>

    <view class="total-summary card">
      <view class="total-row">
        <view class="total-item">
          <text class="total-num {{totalStrokes <= totalPar ? 'text-green' : ''}}">{{totalStrokes}}</text>
          <text class="total-label">总杆</text>
        </view>
        <view class="total-item">
          <text class="total-num">{{totalPar}}</text>
          <text class="total-label">标准杆</text>
        </view>
        <view class="total-item">
          <text class="total-num {{totalStrokes > totalPar ? 'text-danger' : 'text-green'}}">
            {{u.calcParDiff(totalStrokes, totalPar)}}
          </text>
          <text class="total-label">成绩</text>
        </view>
      </view>
    </view>

    <!-- 每洞预览 -->
    <view class="card">
      <view class="holes-grid">
        <view 
          wx:for="{{holes}}" 
          wx:key="hole"
          class="hole-item"
        >
          <text class="hole-number">H{{item.hole}}</text>
          <text class="hole-strokes">{{item.strokes}}</text>
          <text class="hole-par">Par{{item.par}}</text>
        </view>
      </view>
    </view>

    <view class="action-buttons">
      <button class="btn-edit" bindtap="goBackEdit">← 返回修改</button>
      <button class="btn-primary" bindtap="saveRound" loading="{{saveLoading}}">保存成绩</button>
    </view>
  </view>

  <!-- 底部已输入统计 -->
  <view wx:if="{{step === 'input_score'}}" class="bottom-bar">
    <text>已输入 {{holes.filter(h => h.inputted).length}}/18 洞</text>
    <button class="btn-primary small" bindtap="confirmHole">直接完成</button>
  </view>
</view>
