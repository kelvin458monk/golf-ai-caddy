/* pages/index/index.wxss */

.hero {
  background: linear-gradient(135deg, #1B8A6B 0%, #2ECC71 100%);
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
  border-radius: 0 0 40rpx 40rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
}

.hero-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 12rpx;
  display: block;
}

.hero-btn {
  background: #FFFFFF;
  color: #1B8A6B;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 40rpx;
  border: none;
  display: inline-block;
}

.hero-btn:active {
  opacity: 0.85;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 比赛卡片 */
.round-card {
  margin: 20rpx 30rpx;
  padding: 30rpx;
}

.round-card:active {
  transform: scale(0.98);
}

.round-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.round-course {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.round-date {
  font-size: 24rpx;
  color: #999;
}

.round-body {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.round-stats {
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.text-danger {
  color: #E74C3C;
}

.text-green {
  color: #1B8A6B;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}
