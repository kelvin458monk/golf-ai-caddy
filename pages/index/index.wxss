/* pages/index/index.wxss */

.hero {
  background: linear-gradient(135deg, #1B8A6B 0%, #2ECC71 100%);
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
  border-radius: 0 0 40rpx 40rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFF;
  display: block;
}

.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 12rpx;
  display: block;
}

.hero-btn {
  background: #FFF;
  color: #1B8A6B;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 40rpx;
  border: none;
  display: inline-block;
}

.hero-btn:active { opacity: 0.85; }

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 10rpx;
}

.rounds-section {
  padding: 20rpx 0 40rpx;
}

.section-header {
  padding: 0 30rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.round-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
}

.round-card:active { transform: scale(0.98); }

.round-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.round-course {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.round-date {
  font-size: 22rpx;
  color: #999;
}

.round-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.stat-item {
  text-align: center;
}

.stat-val {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.stat-label {
  font-size: 20rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.text-green { color: #1B8A6B; }
.text-danger { color: #E74C3C; }