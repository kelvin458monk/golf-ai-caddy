/* pages/mine/mine.wxss */

.user-section {
  text-align: center;
  padding: 60rpx 0 40rpx;
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  border-radius: 0 0 40rpx 40rpx;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  font-size: 60rpx;
  display: inline-block;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFF;
  margin-top: 16rpx;
}

.login-btn {
  background: rgba(255,255,255,0.25);
  color: #FFF;
  border: 2rpx solid rgba(255,255,255,0.4);
  border-radius: 50rpx;
  padding: 14rpx 60rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
  display: inline-block;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  justify-content: space-around;
  padding: 30rpx;
  margin-top: -30rpx;
  position: relative;
  z-index: 1;
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1B8A6B;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

/* 菜单 */
.menu-section {
  margin: 30rpx;
  background: #FFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F9F9F9;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #CCC;
}

/* 版本号 */
.version-info {
  text-align: center;
  padding: 40rpx 0;
  color: #CCC;
  font-size: 22rpx;
}
