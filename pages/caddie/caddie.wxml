<!-- pages/caddie/caddie.wxml -->
<!-- 球童端：扫码进入的记录页面 -->
<view class="container">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 已完成状态 -->
  <view wx:elif="{{isCompleted}}" class="completed-page">
    <view class="completed-icon">✅</view>
    <text class="completed-title">记录完成！</text>
    <text class="completed-sub">球员可扫码查看成绩报告</text>
    <view class="summary-card card">
      <text class="card-title">本场成绩</text>
      <text class="total-score">{{totalStrokes}}</text>
      <text class="total-label">总杆</text>
    </view>
    <button class="btn-primary" bindtap="viewRecord">查看详细记录</button>
  </view>

  <!-- 记录进行中 -->
  <view wx:else class="record-page">
    <!-- 顶部：洞号 + 球场 -->
    <view class="record-header">
      <view class="hole-badge">H{{currentHole}}</view>
      <view class="course-info">
        <text class="course-name">{{courseName}}</text>
        <text class="hole-progress">第 {{currentHole}} / {{totalHoles}} 洞</text>
      </view>
    </view>

    <!-- 进度条 -->
    <view class="progress-bar">
      <view 
        wx:for="{{holes}}" 
        wx:key="holeNumber" 
        class="dot {{item.done ? 'done' : ''}}"
      ></view>
    </view>

    <!-- 杆数输入 -->
    <view class="input-section card">
      <text class="section-title">杆数</text>
      <view class="stroke-row">
        <view class="stroke-btn" bindtap="adjustStrokes" data-delta="-1">−</view>
        <text class="stroke-num">{{strokes}}</text>
        <view class="stroke-btn" bindtap="adjustStrokes" data-delta="1">+</view>
      </view>
      <view class="quick-row">
        <view 
          wx:for="{{[1,2,3,4,5,6,7,8,9]}}" 
          wx:key="*this"
          class="quick-btn {{strokes === item ? 'active' : ''}}"
          bindtap="setStrokes"
          data-val="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <!-- 球杆选择 -->
    <view class="input-section card">
      <text class="section-title">使用球杆</text>
      <view class="club-grid">
        <view 
          wx:for="{{clubOptions}}" 
          wx:key="id"
          class="club-btn {{selectedClubs.indexOf(item.id) > -1 ? 'active' : ''}}"
          bindtap="toggleClub"
          data-id="{{item.id}}"
        >{{item.name}}</view>
      </view>
    </view>

    <!-- 推杆数 -->
    <view class="input-section card">
      <text class="section-title">推杆数</text>
      <view class="putt-row">
        <view class="stroke-btn small" bindtap="adjustPutts" data-delta="-1">−</view>
        <text class="putt-num">{{putts}}</text>
        <view class="stroke-btn small" bindtap="adjustPutts" data-delta="1">+</view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="input-section card">
      <text class="section-title">备注（选填）</text>
      <input 
        class="note-input" 
        placeholder="OB/下水/一切进洞..."
        value="{{note}}"
        bindinput="onNoteInput"
      />
    </view>

    <!-- 确认按钮 -->
    <button class="btn-confirm" bindtap="confirmHole">
      {{currentHole >= 18 ? '完成记录' : '确认，下一洞'}}
    </button>
  </view>
</view>