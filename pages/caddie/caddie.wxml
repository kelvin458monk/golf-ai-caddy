<!-- pages/caddie/caddie.wxml - 逐杆记录版 -->
<view class="container">

  <view wx:if="{{loading}}" class="loading"><text>加载中...</text></view>

  <view wx:elif="{{isCompleted}}" class="completed-page">
    <text class="icon">✅</text>
    <text class="title">记录完成！</text>
    <text class="score-big">{{totalStrokes}}</text>
    <text class="score-label">总杆</text>
    <button class="btn" bindtap="viewRecord">查看详情</button>
  </view>

  <view wx:else class="page">
    <!-- 顶部：洞号 + 球场 + 统计 -->
    <view class="top-bar">
      <view class="top-left">
        <text class="hole-num">H{{currentHole}}</text>
        <view class="top-info">
          <text class="course">{{courseName}}</text>
          <text class="par">标准杆{{holes[currentHole-1].par}}</text>
        </view>
      </view>
      <view class="top-right">
        <text class="stat">{{doneCount}}洞</text>
        <text class="stat">{{totalStrokes}}杆</text>
      </view>
    </view>

    <!-- 18洞进度条 -->
    <view class="holes-bar">
      <view class="row">
        <view wx:for="{{holes}}" wx:key="holeNumber" wx:if="{{item.holeNumber <= 9}}"
          class="hole {{item.done ? 'done' : ''}} {{currentHole === item.holeNumber ? 'cur' : ''}}"
          data-hole="{{item.holeNumber}}" bindtap="editHole">
          <text class="h">H{{item.holeNumber}}</text>
          <text class="p">P{{item.par}}</text>
          <text class="s">{{item.done ? item.strokes.length : '-'}}</text>
        </view>
      </view>
      <view class="row">
        <view wx:for="{{holes}}" wx:key="holeNumber" wx:if="{{item.holeNumber > 9}}"
          class="hole {{item.done ? 'done' : ''}} {{currentHole === item.holeNumber ? 'cur' : ''}}"
          data-hole="{{item.holeNumber}}" bindtap="editHole">
          <text class="h">H{{item.holeNumber}}</text>
          <text class="p">P{{item.par}}</text>
          <text class="s">{{item.done ? item.strokes.length : '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 已记录的杆 -->
    <view class="stroke-record" wx:if="{{strokes.length > 0}}">
      <text class="record-label">已记：</text>
      <view wx:for="{{strokes}}" wx:key="*this" class="record-row">
        <text class="stroke-num">{{index + 1}}</text>
        <text class="stroke-club {{item.isPutt ? 'putt' : ''}}">{{item.club}}</text>
        <text class="stroke-type">{{item.isPutt ? '推' : '击'}}</text>
      </view>
    </view>

    <!-- 当前杆数显示 -->
    <view class="current-strokes">
      <text class="cur-text">第 {{strokes.length + 1}} 杆</text>
    </view>

    <!-- 球杆选择 -->
    <view class="club-section">
      <text class="label">选择球杆</text>
      <view class="club-row">
        <view wx:for="{{clubOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="selectClub"
          class="club-tag {{selectedClub === item.id ? 'sel' : ''}}">{{item.name}}</view>
      </view>
    </view>

    <!-- 确认按钮 -->
    <view class="confirm-section">
      <view class="confirm-btns" wx:if="{{selectedClub}}">
        <button class="btn-shot" data-putt="false" bindtap="confirmAsShot">击球确认</button>
        <button class="btn-putt" data-putt="true" bindtap="confirmAsPutt">推杆确认</button>
      </view>
      <button class="btn-remove" bindtap="removeLastStroke" wx:if="{{strokes.length > 0}}">撤销上一杆</button>
    </view>

    <!-- 底部：完成本洞 -->
    <view class="bottom-area" wx:if="{{strokes.length > 0}}">
      <view class="hole-summary">
        <text class="summary-text">本洞：{{strokes.length}} 杆</text>
      </view>
      <view class="bottom-btns">
        <button class="btn-prev" bindtap="editLastHole" wx:if="{{currentHole > 1}}">← 上一洞</button>
        <button class="btn-confirm" bindtap="confirmHole">
          {{currentHole >= 18 ? '完成' : '下一洞 →'}}
        </button>
      </view>
    </view>
  </view>
</view>