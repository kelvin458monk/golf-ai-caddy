<!-- pages/caddie/caddie.wxml -->
<view class="container">

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{isCompleted}}" class="completed-page">
    <text class="completed-icon">✅</text>
    <text class="completed-title">记录完成！</text>
    <text class="completed-sub">球员可扫码查看成绩报告</text>
    <view class="summary-card card">
      <text class="card-title">本场成绩</text>
      <text class="total-score">{{totalStrokes}}</text>
      <text class="total-label">总杆</text>
    </view>
    <button class="btn-primary" bindtap="viewRecord">查看详细记录</button>
  </view>

  <view wx:else class="record-page">

    <!-- 顶部信息 -->
    <view class="record-header">
      <view class="header-left">
        <view class="hole-badge">H{{currentHole}}</view>
        <view class="course-info">
          <text class="course-name">{{courseName}}</text>
          <text class="hole-progress">第 {{currentHole}} / {{totalHoles}} 洞 · 标准杆{{holes[currentHole-1].par}}</text>
        </view>
      </view>
      <view class="header-right">
        <view class="live-stat">
          <text class="stat-label">已记</text>
          <text class="stat-num">{{doneCount}}</text>
        </view>
        <view class="live-stat">
          <text class="stat-label">当前</text>
          <text class="stat-num">{{strokes}}</text>
        </view>
        <view class="live-stat">
          <text class="stat-label">累计</text>
          <text class="stat-num">{{totalStrokes}}</text>
        </view>
      </view>
    </view>

    <!-- 18洞概览 -->
    <view class="holes-overview">
      <view class="hole-row">
        <block wx:for="{{holes}}" wx:for-item="hole" wx:key="holeNumber" wx:if="{{hole.holeNumber <= 9}}">
          <view class="hole-item {{hole.done ? 'done' : ''}} {{currentHole === hole.holeNumber ? 'current' : ''}}">
            <text class="hole-num">H{{hole.holeNumber}}</text>
            <text class="hole-par">P{{hole.par}}</text>
            <text class="hole-score">{{hole.done ? hole.strokes : '-'}}</text>
          </view>
        </block>
      </view>
      <view class="hole-row">
        <block wx:for="{{holes}}" wx:for-item="hole" wx:key="holeNumber" wx:if="{{hole.holeNumber > 9}}">
          <view class="hole-item {{hole.done ? 'done' : ''}} {{currentHole === hole.holeNumber ? 'current' : ''}}">
            <text class="hole-num">H{{hole.holeNumber}}</text>
            <text class="hole-par">P{{hole.par}}</text>
            <text class="hole-score">{{hole.done ? hole.strokes : '-'}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 杆数输入 -->
    <view class="input-section card">
      <text class="section-title">杆数</text>
      <view class="stroke-row">
        <view class="stroke-btn" data-delta="-1" bindtap="adjustStrokes">−</view>
        <text class="stroke-num">{{strokes}}</text>
        <view class="stroke-btn" data-delta="1" bindtap="adjustStrokes">+</view>
      </view>
      <view class="quick-row">
        <view wx:for="{{[1,2,3,4,5,6,7,8,9]}}" wx:key="*this" data-val="{{item}}" bindtap="adjustStrokes" class="quick-btn {{strokes === item ? 'active' : ''}}">{{item}}</view>
      </view>
    </view>

    <!-- 球杆选择 -->
    <view class="input-section card">
      <text class="section-title">使用球杆</text>
      <text class="section-hint">（可多选）</text>
      <view class="club-list">
        <block wx:for="{{clubOptions}}" wx:key="id">
          <view class="club-row" data-id="{{item.id}}" bindtap="toggleClub">
            <view class="club-check {{selectedClubs.indexOf(item.id) >= 0 ? 'checked' : ''}}">
              <text wx:if="{{selectedClubs.indexOf(item.id) >= 0}}">✓</text>
            </view>
            <text class="club-name">{{item.name}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 推杆数 -->
    <view class="input-section card">
      <text class="section-title">推杆数</text>
      <view class="putt-row">
        <view class="stroke-btn small" data-delta="-1" bindtap="adjustPutts">−</view>
        <text class="putt-num">{{putts}}</text>
        <view class="stroke-btn small" data-delta="1" bindtap="adjustPutts">+</view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="input-section card">
      <text class="section-title">备注（选填）</text>
      <input class="note-input" placeholder="OB/下水/一切进洞..." value="{{note}}" bindinput="onNoteInput" />
    </view>

    <!-- 确认按钮 -->
    <button class="btn-confirm" bindtap="confirmHole">{{currentHole >= 18 ? '完成记录' : '确认，下一洞'}}</button>
  </view>
</view>