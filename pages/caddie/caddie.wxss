/* pages/caddie/caddie.wxss */

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 顶部区域 */
.record-header {
  background: linear-gradient(135deg, #1B8A6B 0%, #2ECC71 100%);
  padding: 30rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hole-badge {
  background: #FFF;
  color: #1B8A6B;
  font-size: 36rpx;
  font-weight: 700;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
}

.course-info {
  display: flex;
  flex-direction: column;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFF;
}

.hole-progress {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.header-right {
  display: flex;
  gap: 12rpx;
}

.live-stat {
  text-align: center;
  background: rgba(255,255,255,0.2);
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
}

.live-stat .stat-label {
  font-size: 18rpx;
  color: rgba(255,255,255,0.8);
  display: block;
}

.live-stat .stat-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFF;
  display: block;
}

/* 18洞概览 */
.holes-overview {
  padding: 14rpx 24rpx;
  background: #FFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.hole-row {
  display: flex;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.hole-row:last-child {
  margin-bottom: 0;
}

.hole-item {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  background: #F5F5F5;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
}

.hole-item.done {
  background: #E8F5E9;
}

.hole-item.current {
  border-color: #1B8A6B;
  background: #F0FFF8;
}

.hole-num {
  font-size: 16rpx;
  color: #999;
  display: block;
}

.hole-par {
  font-size: 16rpx;
  color: #888;
  display: block;
}

.hole-score {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.hole-item.done .hole-score {
  color: #1B8A6B;
}

/* 输入区域 */
.input-section {
  margin: 14rpx 24rpx;
  padding: 22rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: inline-block;
}

.section-hint {
  font-size: 22rpx;
  color: #999;
  margin-left: 10rpx;
}

/* 杆数输入 */
.stroke-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 18rpx;
}

.stroke-btn {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  color: #FFF;
  font-size: 40rpx;
  font-weight: 700;
  border-radius: 50%;
  text-align: center;
  line-height: 80rpx;
}

.stroke-btn.small {
  width: 60rpx;
  height: 60rpx;
  font-size: 32rpx;
  line-height: 60rpx;
}

.stroke-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #333;
  min-width: 100rpx;
  text-align: center;
}

.quick-row {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
}

.quick-btn {
  flex: 1;
  padding: 14rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  background: #F5F5F5;
  border-radius: 10rpx;
}

.quick-btn.active {
  background: #1B8A6B;
  color: #FFF;
}

/* 球杆选择 - 整行可点 */
.club-list {
  margin-top: 14rpx;
}

.club-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.club-row:last-child {
  border-bottom: none;
}

.club-check {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #DDD;
  border-radius: 10rpx;
  text-align: center;
  line-height: 48rpx;
  font-size: 26rpx;
  color: #FFF;
  margin-right: 20rpx;
}

.club-check.checked {
  background: #1B8A6B;
  border-color: #1B8A6B;
}

.club-name {
  font-size: 30rpx;
  color: #333;
}

/* 推杆数 */
.putt-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
}

.putt-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  min-width: 80rpx;
  text-align: center;
}

/* 备注 */
.note-input {
  border: 1rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 28rpx;
  background: #FAFAFA;
  margin-top: 10rpx;
}

/* 确认按钮 */
.btn-confirm {
  margin: 16rpx 24rpx 40rpx;
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  color: #FFF;
  border-radius: 50rpx;
  padding: 26rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

/* 已完成页面 */
.completed-page {
  text-align: center;
  padding: 80rpx 40rpx;
}

.completed-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.completed-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.completed-sub {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 40rpx;
}

.summary-card {
  margin: 30rpx 0;
  padding: 40rpx;
}

.card-title {
  font-size: 26rpx;
  color: #999;
  display: block;
}

.total-score {
  font-size: 80rpx;
  font-weight: 800;
  color: #1B8A6B;
  display: block;
}

.total-label {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.btn-primary {
  margin: 20rpx 24rpx;
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  color: #FFF;
  border-radius: 50rpx;
  padding: 26rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}