/* pages/caddie/caddie.wxss - 逐杆记录版 */

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 顶部条 */
.top-bar {
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.top-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hole-num {
  background: #FFF;
  color: #1B8A6B;
  font-size: 36rpx;
  font-weight: 700;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
}

.top-info {
  display: flex;
  flex-direction: column;
}

.course {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFF;
}

.par {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.top-right {
  display: flex;
  gap: 12rpx;
}

.stat {
  background: rgba(255,255,255,0.2);
  color: #FFF;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

/* 18洞进度条 */
.holes-bar {
  background: #FFF;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #EEE;
}

.row {
  display: flex;
  gap: 4rpx;
  margin-bottom: 4rpx;
}

.row:last-child {
  margin-bottom: 0;
}

.hole {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  background: #F5F5F5;
  border-radius: 6rpx;
  border: 2rpx solid transparent;
}

.hole.done {
  background: #E8F5E9;
}

.hole.cur {
  border-color: #1B8A6B;
  background: #E8F5E9;
}

.h {
  font-size: 16rpx;
  color: #999;
  display: block;
}

.p {
  font-size: 16rpx;
  color: #888;
  display: block;
}

.s {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.hole.done .s {
  color: #1B8A6B;
}

/* 已记录杆数列表 */
.stroke-record {
  background: #FFF;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #EEE;
}

.record-label {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.record-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.stroke-num {
  width: 50rpx;
  font-size: 24rpx;
  color: #999;
  font-weight: 600;
}

.stroke-club {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.stroke-club.putt {
  color: #1B8A6B;
}

.stroke-type {
  font-size: 20rpx;
  color: #FFF;
  background: #1B8A6B;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.stroke-club.putt + .stroke-type {
  background: #888;
}

/* 当前杆数 */
.current-strokes {
  padding: 24rpx;
  text-align: center;
  background: #FFF;
  border-bottom: 1rpx solid #EEE;
}

.cur-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

/* 球杆选择 */
.club-section {
  padding: 20rpx 24rpx;
  background: #FFF;
  margin-bottom: 16rpx;
}

.label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.club-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.club-tag {
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
  border: 2rpx solid #DDD;
  border-radius: 24rpx;
}

.club-tag.sel {
  background: #1B8A6B;
  color: #FFF;
  border-color: #1B8A6B;
}

/* 确认按钮 */
.confirm-section {
  padding: 0 24rpx 16rpx;
  background: #FFF;
}

.confirm-btns {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.btn-shot, .btn-putt {
  flex: 1;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
}

.btn-shot {
  background: #1B8A6B;
  color: #FFF;
}

.btn-putt {
  background: #FFF;
  color: #888;
  border: 2rpx solid #CCC;
}

.btn-remove {
  background: none;
  color: #999;
  font-size: 24rpx;
  border: none;
  padding: 10rpx;
}

/* 底部区域 */
.bottom-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFF;
  padding: 16rpx 24rpx 40rpx;
  border-top: 1rpx solid #EEE;
}

.hole-summary {
  text-align: center;
  margin-bottom: 12rpx;
}

.summary-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1B8A6B;
}

.bottom-btns {
  display: flex;
  gap: 16rpx;
}

.btn-prev {
  background: #FFF;
  color: #666;
  border: 2rpx solid #DDD;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
}

.btn-confirm {
  flex: 1;
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  color: #FFF;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

/* 已完成页 */
.completed-page {
  text-align: center;
  padding: 100rpx 40rpx;
  background: linear-gradient(135deg, #1B8A6B 0%, #2ECC71 100%);
  min-height: 100vh;
}

.icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFF;
  display: block;
  margin-bottom: 30rpx;
}

.score-big {
  font-size: 100rpx;
  font-weight: 800;
  color: #FFF;
  display: block;
}

.score-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-bottom: 40rpx;
}

.btn {
  background: #FFF;
  color: #1B8A6B;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}