/* pages/caddie/caddie.wxss */

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 已完成页 */
.completed-page {
  text-align: center;
  padding: 80rpx 40rpx;
}

.completed-icon {
  font-size: 120rpx;
}

.completed-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-top: 20rpx;
}

.completed-sub {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 10rpx;
}

.summary-card {
  margin: 40rpx 0;
  padding: 40rpx;
}

.total-score {
  font-size: 80rpx;
  font-weight: 800;
  color: #1B8A6B;
  display: block;
}

.total-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

/* 记录页 */
.record-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
}

.hole-badge {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  text-align: center;
  line-height: 80rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFF;
  margin-right: 20rpx;
}

.course-info {
  flex: 1;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFF;
  display: block;
}

.hole-progress {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-top: 4rpx;
}

/* 进度条 */
.progress-bar {
  display: flex;
  gap: 6rpx;
  padding: 16rpx 30rpx;
  background: #FFF;
}

.dot {
  flex: 1;
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
}

.dot.done {
  background: #2ECC71;
}

/* 输入区块 */
.input-section {
  margin: 16rpx 24rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

/* 杆数输入 */
.stroke-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 16rpx;
}

.stroke-btn {
  width: 80rpx;
  height: 80rpx;
  background: #F0F0F0;
  border-radius: 50%;
  text-align: center;
  line-height: 80rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
}

.stroke-btn.small {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 36rpx;
}

.stroke-btn:active {
  background: #DDD;
}

.stroke-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #1B8A6B;
  width: 100rpx;
  text-align: center;
}

/* 快捷数字 */
.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.quick-btn {
  width: 56rpx;
  height: 56rpx;
  background: #F5F5F5;
  border-radius: 50%;
  text-align: center;
  line-height: 56rpx;
  font-size: 26rpx;
  color: #666;
}

.quick-btn.active {
  background: #1B8A6B;
  color: #FFF;
}

/* 球杆选择 */
.club-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.club-btn {
  padding: 12rpx 20rpx;
  background: #F5F5F5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.club-btn.active {
  background: #E8F5E9;
  border-color: #1B8A6B;
  color: #1B8A6B;
}

/* 推杆 */
.putt-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.putt-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1B8A6B;
  width: 80rpx;
  text-align: center;
}

/* 备注 */
.note-input {
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #333;
}

/* 确认按钮 */
.btn-confirm {
  margin: 30rpx 24rpx;
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  color: #FFF;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.btn-confirm:active {
  opacity: 0.85;
}

.btn-primary {
  margin: 20rpx 24rpx;
  background: #1B8A6B;
  color: #FFF;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 30rpx;
  border: none;
}