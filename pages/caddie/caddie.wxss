/* pages/caddie/caddie.wxss - 逐杆记录版 */

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 顶部条 */
.top-bar {
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.top-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hole-num {
  background: #FFF;
  color: #1B8A6B;
  font-size: 36rpx;
  font-weight: 700;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
}

.top-info {
  display: flex;
  flex-direction: column;
}

.course {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFF;
}

.par {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.top-right {
  display: flex;
  gap: 12rpx;
}

.stat {
  background: rgba(255,255,255,0.2);
  color: #FFF;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

/* 18洞进度条 */
.holes-bar {
  background: #FFF;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #EEE;
}

.row {
  display: flex;
  gap: 4rpx;
  margin-bottom: 4rpx;
}

.row:last-child {
  margin-bottom: 0;
}

.hole {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  background: #F5F5F5;
  border-radius: 6rpx;
  border: 2rpx solid transparent;
}

.hole.done {
  background: #E8F5E9;
}

.hole.cur {
  border-color: #1B8A6B;
  background: #E8F5E9;
}

.h {
  font-size: 16rpx;
  color: #999;
  display: block;
}

.p {
  font-size: 16rpx;
  color: #888;
  display: block;
}

.s {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.hole.done .s {
  color: #1B8A6B;
}

/* 已选球杆记录 */
.club-record {
  background: #FFF;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #EEE;
}

.record-title {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.record-item {
  font-size: 26rpx;
  color: #1B8A6B;
  font-weight: 600;
  display: inline-block;
  margin-right: 20rpx;
  margin-bottom: 8rpx;
}

/* 杆数进度 */
.stroke-progress {
  padding: 20rpx 24rpx;
  background: #FFF;
  margin-bottom: 16rpx;
}

.prog-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
  text-align: center;
}

.prog-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #E0E0E0;
}

.dot.filled {
  background: #1B8A6B;
}

/* 输入区 */
.input-area {
  padding: 16rpx 24rpx;
}

.row-section {
  margin-bottom: 16rpx;
}

.label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.row-input {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-sm {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  color: #FFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 50%;
  text-align: center;
  line-height: 60rpx;
}

.big-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #333;
  min-width: 80rpx;
  text-align: center;
}

.mid-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  min-width: 60rpx;
  text-align: center;
}

/* 球杆标签云 */
.club-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.club-tag {
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  background: #FFF;
  border: 2rpx solid #DDD;
  border-radius: 24rpx;
}

.club-tag.sel {
  background: #1B8A6B;
  color: #FFF;
  border-color: #1B8A6B;
}

/* 确认这一杆按钮 */
.stroke-confirm {
  margin: 16rpx 0;
}

.confirm-stroke-btn {
  background: #FFF;
  color: #1B8A6B;
  border: 2rpx solid #1B8A6B;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.confirm-stroke-btn[disabled] {
  color: #CCC;
  border-color: #DDD;
}

/* 备注 */
.note {
  background: #FFF;
  border: 1rpx solid #DDD;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 26rpx;
}

/* 底部按钮 */
.bottom-btns {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx 40rpx;
}

.btn-edit {
  background: #FFF;
  color: #666;
  border: 2rpx solid #DDD;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.confirm-btn {
  flex: 1;
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  color: #FFF;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

/* 已完成页 */
.completed-page {
  text-align: center;
  padding: 100rpx 40rpx;
  background: linear-gradient(135deg, #1B8A6B 0%, #2ECC71 100%);
  min-height: 100vh;
}

.icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFF;
  display: block;
  margin-bottom: 30rpx;
}

.score-big {
  font-size: 100rpx;
  font-weight: 800;
  color: #FFF;
  display: block;
}

.score-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-bottom: 40rpx;
}

.btn {
  background: #FFF;
  color: #1B8A6B;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}