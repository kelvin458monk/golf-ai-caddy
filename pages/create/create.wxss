/* pages/create/create.wxss */

.step-header {
  text-align: center;
  padding: 40rpx 0;
}

.step-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.step-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

/* 球场选择 */
.course-list {
  padding: 0 24rpx;
}

.course-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.course-card.selected {
  border: 2rpx solid #1B8A6B;
  background: #F8FFF9;
}

.course-info {
  flex: 1;
}

.course-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.course-detail {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.check-icon {
  font-size: 40rpx;
  color: #1B8A6B;
  font-weight: 700;
}

.btn-primary {
  margin: 30rpx 24rpx;
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  color: #FFF;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  text-align: center;
}

.btn-primary:active { opacity: 0.85; }

.btn-secondary {
  background: #F5F5F5;
  color: #666;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: none;
  text-align: center;
}

.btn-secondary:active { opacity: 0.85; }

.btn-back {
  margin: 20rpx 24rpx;
  background: none;
  color: #999;
  font-size: 26rpx;
  border: none;
  text-align: center;
}

/* 记录方式选择 */
.choice-list {
  padding: 0 24rpx;
}

.choice-card {
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.choice-card:active {
  background: #F8FFF9;
  transform: scale(0.98);
}

.choice-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}

.choice-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.choice-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  display: block;
}

/* 二维码页 */
.qr-header {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.qr-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.qr-course {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.qr-area {
  margin: 30rpx 24rpx;
  padding: 40rpx;
  text-align: center;
}

.qr-box {
  background: #FFF;
  border: 4rpx dashed #1B8A6B;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
}

.qr-hint {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}

.qr-roomid {
  font-size: 28rpx;
  font-weight: 600;
  color: #1B8A6B;
  word-break: break-all;
  display: block;
}

.qr-tips {
  padding: 0 40rpx;
  margin-bottom: 30rpx;
}

.tip-item {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.qr-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx;
}

.qr-actions .btn-secondary { flex: 1; }
.qr-actions .btn-primary { flex: 2; }