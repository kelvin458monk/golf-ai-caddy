/* pages/create/create.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
}

.page {
  padding: 30rpx;
}

/* 头部 */
.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  display: block;
}

/* 球场列表 */
.course-list {
  margin-bottom: 40rpx;
}

.course-card {
  background: #FFF;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid transparent;
}

.course-card.selected {
  border-color: #1B8A6B;
  background: #F0FFF8;
}

.card-left {
  display: flex;
  flex-direction: column;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.course-info {
  font-size: 22rpx;
  color: #999;
}

.card-arrow {
  font-size: 36rpx;
  color: #1B8A6B;
  font-weight: 700;
}

/* 天马组合选择 */
.combo-list {
  margin-bottom: 30rpx;
}

.combo-card {
  background: #FFF;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.combo-card.selected {
  border-color: #1B8A6B;
  background: #F0FFF8;
}

.combo-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.combo-par {
  font-size: 22rpx;
  color: #999;
}

.selected-info {
  text-align: center;
  margin-bottom: 30rpx;
}

.info-text {
  font-size: 28rpx;
  color: #1B8A6B;
  font-weight: 600;
}

/* 按钮通用 */
.btn-primary {
  background: linear-gradient(135deg, #1B8A6B, #2ECC71);
  color: #FFF;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  width: 100%;
}

.btn-primary[disabled] {
  background: #CCC;
  color: #FFF;
}

.btn-back {
  background: #FFF;
  color: #666;
  border: 2rpx solid #DDD;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 16rpx;
}

.btn-group {
  display: flex;
  gap: 16rpx;
}

.btn-group .btn-back {
  flex: 1;
  margin-bottom: 0;
}

.btn-group .btn-primary {
  flex: 2;
}

/* 记录方式 */
.mode-cards {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.mode-card {
  flex: 1;
  background: #FFF;
  padding: 40rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
  border: 2rpx solid #EEE;
}

.mode-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}

.mode-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.mode-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
}

/* 二维码页 */
.qr-page {
  text-align: center;
  padding: 60rpx 30rpx;
}

.qr-header {
  margin-bottom: 40rpx;
}

.qr-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.qr-subtitle {
  font-size: 26rpx;
  color: #999;
  display: block;
}

.qr-box {
  background: #FFF;
  padding: 60rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.qr-placeholder {
  font-size: 28rpx;
  color: #CCC;
  display: block;
  margin-bottom: 20rpx;
}

.room-id {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.qr-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.btn-secondary {
  flex: 1;
  background: #FFF;
  color: #666;
  border: 2rpx solid #DDD;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}